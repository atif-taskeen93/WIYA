<div class="wiya-values page-width">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="wiya-values__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="wiya-values__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="wiya-values__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="wiya-values__list" role="list">
    {%- for block in section.blocks -%}
      <li class="wiya-values__item" {{ block.shopify_attributes }}>
        {%- if block.settings.title != blank -%}
          <h3 class="wiya-values__title">{{ block.settings.title | escape }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="wiya-values__text rte">{{ block.settings.text }}</div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .wiya-values {
    padding-top: 3.2rem;
    padding-bottom: 1.2rem;
  }

  .wiya-values__intro {
    max-width: 42rem;
    margin: 0 auto 3.2rem;
    text-align: center;
  }

  .wiya-values__heading {
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    letter-spacing: 0.04em;
    color: #46161d;
    margin: 0 0 1.2rem;
  }

  .wiya-values__subheading,
  .wiya-values__subheading p {
    margin: 0;
    color: #221d20;
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .wiya-values__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wiya-values__item {
    text-align: center;
    padding: 0 1rem;
  }

  .wiya-values__title {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #46161d;
    margin: 0 0 0.8rem;
  }

  .wiya-values__text,
  .wiya-values__text p {
    margin: 0;
    color: #221d20;
    font-size: 1.4rem;
    line-height: 1.65;
  }

  @media screen and (min-width: 750px) {
    .wiya-values__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.2rem 2.4rem;
    }

    .wiya-values__heading {
      font-size: 3.2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .wiya-values__list {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WIYA values",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What we value"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Pieces made with softness, structure, flow and intention.</p>"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Softness"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Fabrics chosen to sit close to the skin.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WIYA values",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
