{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<div class="wiya-brand-band">
  {%- if section.settings.image != blank -%}
    <div class="wiya-brand-band__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'wiya-brand-band__img',
          widths: '750, 1100, 1500, 1780, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}
  <div class="wiya-brand-band__content">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 720
        | image_tag: class: 'wiya-brand-band__logo',
          alt: shop.name,
          widths: '280, 420, 560, 720',
          sizes: '280px'
      }}
    {%- endif -%}
    {% render 'wiya-tagline', class: 'wiya-tagline--band' %}
    {%- if section.settings.text != blank -%}
      <div class="wiya-brand-band__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        class="wiya-brand-band__button button"
        href="{{ section.settings.button_link | default: '/pages/shop' }}"
      >
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .wiya-brand-band {
    position: relative;
    min-height: 36rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: inset(0);
  }

  @media screen and (min-width: 750px) {
    .wiya-brand-band {
      min-height: 44rem;
    }
  }

  .wiya-brand-band__media {
    position: absolute;
    inset: 0;
  }

  .wiya-brand-band__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(255, 241, 235, 0.72) 0%, rgba(255, 241, 235, 0.28) 70%, rgba(255, 241, 235, 0.12) 100%);
  }

  .wiya-brand-band__img {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    object-fit: cover;
    object-position: center;
  }

  .wiya-brand-band__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 5rem 2rem;
    max-width: 52rem;
  }

  .wiya-brand-band__logo {
    display: block;
    margin: 0 auto 1.2rem;
    height: 72px;
    width: auto;
    filter: drop-shadow(0 1px 0 rgba(255, 241, 235, 0.8));
  }

  .wiya-tagline--band {
    display: block;
    margin: 0 0 1.8rem;
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff1eb;
  }

  .wiya-brand-band__text,
  .wiya-brand-band__text p {
    color: #46161d;
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    line-height: 1.55;
    letter-spacing: 0.02em;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .wiya-brand-band__logo {
      height: 88px;
    }

    .wiya-brand-band__text,
    .wiya-brand-band__text p {
      font-size: 2.2rem;
    }
  }

  .wiya-brand-band__button {
    margin-top: 2.8rem;
    min-width: 16rem;
    background: #46161d;
    color: #fff1eb;
    border: none;
  }

  .wiya-brand-band__button:hover {
    background: #83333a;
    color: #fff1eb;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WIYA brand band",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Parallax image"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Shop softness, structure, and intention — pieces made to be felt before they’re seen.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "WIYA brand band"
    }
  ]
}
{% endschema %}
