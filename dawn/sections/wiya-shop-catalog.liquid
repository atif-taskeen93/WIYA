{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wiya-shop.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign shop_coll = collection
  if shop_coll == blank
    assign shop_coll = collections['shop-all']
  endif
  assign heading = shop_coll.title | default: 'Products'
  if template.name == 'page'
    assign heading = page.title | default: 'Products'
  endif
-%}

{%- paginate shop_coll.products by 20 -%}
  <div class="wiya-store" data-wiya-store>
    <nav class="wiya-store__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span>{{ heading | escape }}</span>
    </nav>
    <header class="wiya-store__head">
      <h1 class="wiya-store__title">{{ heading | escape }}</h1>
    </header>

    {%- if shop_coll == blank or shop_coll.products.size == 0 -%}
      <p class="wiya-store__empty">No pieces yet.</p>
    {%- else -%}
      <ul class="wiya-store__grid" role="list">
        {%- for product in shop_coll.products -%}
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign hover_media = product.media[1]
            assign excerpt = product.description | strip_html | truncate: 220
          -%}
          <li class="wiya-store__card">
            <div class="wiya-store__media" data-wiya-media>
              <a class="wiya-store__photo" href="{{ product.url }}">
                {%- if product.featured_media -%}
                  {%- assign shop_alt = product.featured_media.alt | default: product.title -%}
                  {{
                    product.featured_media
                    | image_url: width: 900
                    | image_tag:
                      class: 'wiya-store__img',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 23vw, 50vw',
                      alt: shop_alt
                  }}
                  {%- if hover_media -%}
                    {{
                      hover_media
                      | image_url: width: 900
                      | image_tag:
                        class: 'wiya-store__img wiya-store__img--hover',
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 990px) 23vw, 50vw',
                        alt: shop_alt,
                        loading: 'lazy'
                    }}
                  {%- endif -%}
                {%- endif -%}
              </a>

              {%- if product.available -%}
                <button class="wiya-store__quick" type="button" data-wiya-quick>Quick add</button>
                <div class="wiya-store__panel">
                  {%- form 'product', product, class: 'wiya-store__form', data-wiya-add: 'true' -%}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    <div class="wiya-store__panel-body">
                      {%- unless product.has_only_default_variant -%}
                        {%- liquid
                          assign current_label = variant.title
                          case variant.title
                            when 'XS'
                              assign current_label = '6 (XS)'
                            when 'S'
                              assign current_label = '8 (S)'
                            when 'M'
                              assign current_label = '10 (M)'
                            when 'L'
                              assign current_label = '12 (L)'
                            when 'XL'
                              assign current_label = '14 (XL)'
                          endcase
                        -%}
                        <div class="wiya-store__field">
                          <p class="wiya-store__size-label">
                            Size:
                            <span data-wiya-size-live>{{ current_label }}</span>
                          </p>
                          <div class="wiya-store__chips" role="list">
                            {%- for size_variant in product.variants -%}
                              {%- liquid
                                assign option_label = size_variant.title
                                case size_variant.title
                                  when 'XS'
                                    assign option_label = '6 (XS)'
                                  when 'S'
                                    assign option_label = '8 (S)'
                                  when 'M'
                                    assign option_label = '10 (M)'
                                  when 'L'
                                    assign option_label = '12 (L)'
                                  when 'XL'
                                    assign option_label = '14 (XL)'
                                endcase
                              -%}
                              <button
                                class="wiya-store__chip{% if size_variant == variant %} is-active{% endif %}"
                                type="button"
                                role="listitem"
                                data-wiya-chip
                                data-variant-id="{{ size_variant.id }}"
                                data-label="{{ option_label | escape }}"
                                data-available="{% if size_variant.available %}true{% else %}false{% endif %}"
                                {% unless size_variant.available %}disabled{% endunless %}
                              >
                                {{ option_label }}
                              </button>
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endunless -%}

                      <div class="wiya-store__field wiya-store__qty">
                        <span class="wiya-store__qty-label">Quantity</span>
                        <div class="wiya-store__qty-ctrl">
                          <button type="button" data-wiya-qty="-1" aria-label="Decrease quantity">−</button>
                          <input type="number" name="quantity" value="1" min="1" inputmode="numeric">
                          <button type="button" data-wiya-qty="1" aria-label="Increase quantity">+</button>
                        </div>
                      </div>
                    </div>

                    <div class="wiya-store__actions">
                      <button class="wiya-store__add" type="submit" data-wiya-add-btn {% unless variant.available %}disabled{% endunless %}>
                        Add to bag
                      </button>
                      <button class="wiya-store__cancel" type="button" data-wiya-close>Cancel</button>
                    </div>
                  {%- endform -%}
                </div>
              {%- else -%}
                <span class="wiya-store__sold">Sold out</span>
              {%- endif -%}
            </div>

            <div class="wiya-store__ticket">
              <h2 class="wiya-store__name">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h2>
              {%- if excerpt != blank -%}
                <p class="wiya-store__copy">{{ excerpt | escape }}</p>
              {%- endif -%}
              <p class="wiya-store__price">
                {%- if variant.compare_at_price > variant.price -%}
                  <s class="wiya-store__compare" data-wiya-amount="{{ variant.compare_at_price }}">{{ variant.compare_at_price | money }}</s>
                {%- endif -%}
                <span class="wiya-store__sale" data-wiya-amount="{{ variant.price }}">{{ variant.price | money }}</span>
              </p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="wiya-store__pages" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .wiya-store {
    background: #fff1eb;
    color: #221d20;
    width: min(128rem, calc(100% - 2.4rem));
    margin: 0 auto;
    padding: 2.4rem 0 6rem;
  }

  .wiya-store__crumb {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    font-size: 1.3rem;
    color: #907961;
    margin-bottom: 1.2rem;
  }

  .wiya-store__crumb a {
    color: #907961;
    text-decoration: none;
  }

  .wiya-store__head {
    text-align: center;
    margin-bottom: 2.8rem;
  }

  .wiya-store__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 3.2rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #221d20;
  }

  .wiya-store__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.2rem 1.2rem;
  }

  .wiya-store__media {
    position: relative;
    overflow: hidden;
    background: #c6b4a8;
  }

  .wiya-store__photo {
    display: block;
    aspect-ratio: 3 / 4;
    position: relative;
  }

  .wiya-store__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wiya-store__img--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .wiya-store__media:hover .wiya-store__img--hover {
    opacity: 1;
  }

  .wiya-store__quick {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    border: 0;
    background: rgba(255, 241, 235, 0.94);
    color: #221d20;
    padding: 1.2rem 1rem;
    font-size: 1.2rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 1;
    transition: opacity 0.25s ease, background 0.2s ease;
  }

  @media screen and (min-width: 750px) {
    .wiya-store__quick {
      opacity: 0;
    }

    .wiya-store__media:hover .wiya-store__quick,
    .wiya-store__media.is-open .wiya-store__quick {
      opacity: 1;
    }
  }

  .wiya-store__media.is-open .wiya-store__quick {
    visibility: hidden;
    opacity: 0;
  }

  .wiya-store__quick:hover {
    background: #fff;
  }

  .wiya-store__sold {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    background: rgba(34, 29, 32, 0.72);
    color: #fff1eb;
    padding: 1.2rem 1rem;
    text-align: center;
    font-size: 1.2rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .wiya-store__panel {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: none;
    background: rgba(255, 241, 235, 0.78);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    padding: 0;
  }

  .wiya-store__media.is-open .wiya-store__panel {
    display: flex;
  }

  .wiya-store__form {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 1.8rem 1.6rem 1.6rem;
    box-sizing: border-box;
  }

  .wiya-store__panel-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-height: 0;
  }

  .wiya-store__field {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .wiya-store__size-label {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5c5148;
  }

  .wiya-store__size-label span {
    color: #221d20;
    font-weight: 500;
  }

  .wiya-store__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .wiya-store__chip {
    min-width: 4.8rem;
    border: 0.1rem solid rgba(34, 29, 32, 0.18);
    background: rgba(255, 255, 255, 0.72);
    padding: 0.7rem 1rem;
    font: inherit;
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    color: #221d20;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .wiya-store__chip:hover:not(:disabled) {
    border-color: #46161d;
  }

  .wiya-store__chip.is-active {
    background: #46161d;
    border-color: #46161d;
    color: #fff1eb;
  }

  .wiya-store__chip:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .wiya-store__qty {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wiya-store__qty-label {
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5c5148;
  }

  .wiya-store__qty-ctrl {
    display: inline-flex;
    align-items: center;
    border: 0.1rem solid rgba(34, 29, 32, 0.18);
    background: rgba(255, 255, 255, 0.72);
  }

  .wiya-store__qty-ctrl button {
    width: 3.2rem;
    height: 3.2rem;
    border: 0;
    background: transparent;
    color: #221d20;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }

  .wiya-store__qty-ctrl button:hover {
    background: rgba(70, 22, 29, 0.06);
  }

  .wiya-store__qty-ctrl input {
    width: 3.6rem;
    height: 3.2rem;
    border: 0;
    border-left: 0.1rem solid rgba(34, 29, 32, 0.12);
    border-right: 0.1rem solid rgba(34, 29, 32, 0.12);
    background: transparent;
    text-align: center;
    font: inherit;
    font-size: 1.3rem;
    color: #221d20;
    -moz-appearance: textfield;
  }

  .wiya-store__qty-ctrl input::-webkit-outer-spin-button,
  .wiya-store__qty-ctrl input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .wiya-store__actions {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1.6rem;
  }

  .wiya-store__add {
    width: 100%;
    border: 0;
    background: #46161d;
    color: #fff1eb;
    padding: 1.2rem 1.4rem;
    font-size: 1.2rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .wiya-store__add:hover:not(:disabled) {
    background: #83333a;
  }

  .wiya-store__add:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .wiya-store__cancel {
    width: 100%;
    border: 0;
    background: transparent;
    color: #907961;
    padding: 0.8rem 1rem;
    font-size: 1.15rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .wiya-store__cancel:hover {
    color: #221d20;
  }

  .wiya-store__ticket {
    padding: 1.4rem 0.2rem 0;
  }

  .wiya-store__name {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .wiya-store__name a {
    color: #221d20;
    text-decoration: none;
  }

  .wiya-store__copy {
    margin: 0.8rem 0 0;
    font-size: 1.35rem;
    line-height: 1.55;
    color: #5c5148;
  }

  .wiya-store__price {
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: baseline;
    font-size: 1.4rem;
    color: #221d20;
  }

  .wiya-store__compare {
    color: #8a7b70;
    text-decoration: line-through;
  }

  .wiya-store__sale {
    color: #221d20;
  }

  .wiya-store__empty,
  .wiya-store__pages {
    margin-top: 2.4rem;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .wiya-store {
      width: min(128rem, calc(100% - 5rem));
      padding-top: 3.2rem;
    }

    .wiya-store__title {
      font-size: 4.4rem;
    }

    .wiya-store__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 4rem 2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .wiya-store__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WIYA shop catalog",
  "tag": "section",
  "class": "wiya-shop-section",
  "settings": [],
  "presets": [
    {
      "name": "WIYA shop catalog"
    }
  ]
}
{% endschema %}
