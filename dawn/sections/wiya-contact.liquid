{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .wiya-contact {
    max-width: 64rem;
    margin: 0 auto;
  }

  .wiya-contact__intro {
    margin: 0 0 2.4rem;
    color: #5c5148;
    font-size: 1.5rem;
    line-height: 1.6;
  }

  .wiya-contact .field,
  .wiya-contact .text-area {
    margin-bottom: 1.2rem;
  }

  .wiya-contact__button .button {
    min-width: 18rem;
    background: #46161d;
    color: #fff1eb;
  }

  .wiya-contact__button .button:hover {
    background: #83333a;
  }

  .wiya-contact__hint {
    margin-top: 1.6rem;
    font-size: 1.25rem;
    color: #907961;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="wiya-contact contact page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <p class="wiya-contact__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    {%- form 'contact', id: 'WiyaContactForm', class: 'isolate' -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          Thank you. Your message has been sent. We typically reply within 24–48 hours.
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            Please fix the errors below and try again.
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#WiyaContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}

      <input type="hidden" name="contact[subject]" value="WIYA website customer query">

      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="WiyaContactForm-name"
            name="contact[name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="Name"
            required
          >
          <label class="field__label" for="WiyaContactForm-name">Name</label>
        </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="WiyaContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="WiyaContactForm-email-error"
            {% endif %}
            placeholder="Email"
          >
          <label class="field__label" for="WiyaContactForm-email">
            Email
            <span aria-hidden="true">*</span>
          </label>
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="WiyaContactForm-email-error">
              <span class="form__message">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      </div>

      <div class="field">
        <input
          type="tel"
          id="WiyaContactForm-phone"
          class="field__input"
          autocomplete="tel"
          name="contact[phone]"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          placeholder="Phone"
        >
        <label class="field__label" for="WiyaContactForm-phone">Phone</label>
      </div>

      <div class="field">
        <input
          type="text"
          id="WiyaContactForm-order"
          class="field__input"
          name="contact[order_number]"
          placeholder="Order number (optional)"
        >
        <label class="field__label" for="WiyaContactForm-order">Order number (optional)</label>
      </div>

      <div class="field">
        <textarea
          rows="8"
          id="WiyaContactForm-body"
          class="text-area field__input"
          name="contact[body]"
          placeholder="Your message"
          required
        >{{- form.body -}}</textarea>
        <label class="form__label field__label" for="WiyaContactForm-body">Message</label>
      </div>

      <div class="contact__button wiya-contact__button">
        <button type="submit" class="button">Send message</button>
      </div>
      <p class="wiya-contact__hint">We typically reply within 24–48 hours.</p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "WIYA contact form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "default": "Questions about orders, sizing, exchanges, or our pieces? Send a message and the WIYA team will get back to you."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [{ "name": "WIYA contact form" }]
}
{% endschema %}
